# RemoteMongo — copia a .env y ajusta

# Puerto donde escucha
RM_PORT=8790

# Dominio público: lo que va detrás de la @ de cada usuario
RM_DOMINIO=remotemongo.eines.net
# si va detrás de un proxy con TLS (obligatorio en producción)
RM_HTTPS=si

# ---- MongoDB (la ruta a la base de datos) ----
RM_MONGO_URL=mongodb://127.0.0.1:27017
RM_MONGO_DB=remotemongo

# Abrir cuentas desde la web
RM_REGISTRO=si

# Cuota de espacio por cuenta, en bytes (100 MB por defecto)
RM_CUOTA_BASE=104857600

# Cifrado en reposo de los documentos (AES-256-GCM).
# 32 bytes en base64 y SIEMPRE fuera de MongoDB: sin esta clave, un dump no se lee.
# Genera una con:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Si usas el asistente de /instalar, se genera sola y se guarda en state/instalacion.json.
RM_CLAVE_CIFRADO=

# Clave para /panel y /respaldo/<usuario>
RM_ADMIN_TOKEN=cambia_esto
